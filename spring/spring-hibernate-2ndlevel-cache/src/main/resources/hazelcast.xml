<?xml version="1.0" encoding="UTF-8"?>
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
           http://www.hazelcast.com/schema/config/hazelcast-config-5.5.xsd">

    <cluster-name>dev</cluster-name>

    <!-- The cache name matches the Hibernate entity region. -->
    <cache name="com.hazelcast.hibernate.springhibernate2lc.persistence.Book">
        <expiry-policy-factory>
            <timed-expiry-policy-factory expiry-policy-type="CREATED" duration-amount="30" time-unit="SECONDS"/>
        </expiry-policy-factory>
    </cache>
</hazelcast>
