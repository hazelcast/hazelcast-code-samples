<server>

    <featureManager>
        <feature>servlet-6.0</feature>
        <feature>distributedMap-1.0</feature>
        <feature>webCache-1.0</feature>
        <!-- Install the Hazelcast 5.7 DynaCache ESA built from upstream source. -->
        <feature>usr:hazelcast-dynacache</feature>
    </featureManager>

    <distributedMap id="some-hz-map" jndiName="services/cache/some-hz-map"
                    cacheProviderName="hazelcast" memorySizeInEntries="1000"/>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080">
        <tcpOptions soReuseAddr="true"/>
    </httpEndpoint>

    <application name="servlet" context-root="/servlet" location="${appLocation}" type="war"/>

    <logging traceSpecification="com.hazelcast.*=finest=enabled"  traceFileName="trace.log"
             maxFileSize="20"  maxFiles="20" traceFormat="BASIC" />

</server>
